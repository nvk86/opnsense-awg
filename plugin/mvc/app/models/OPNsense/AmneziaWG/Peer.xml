<?xml version="1.0"?>
<model>
  <mount>//OPNsense/amneziawg/peers</mount>
  <description>AmneziaWG Server Peers</description>
  <version>1.0.0</version>
  <items>
    <peer type="ArrayField">
      <enabled type="BooleanField"><default>1</default><Required>N</Required></enabled>
      <name type="TextField"><Required>Y</Required><mask>/^[a-zA-Z0-9_\-]{1,31}$/</mask></name>
      <server type="TextField"><Required>Y</Required><mask>/^[a-fA-F0-9\-]{36}$/</mask><ValidationMessage>Select a server</ValidationMessage></server>
      <public_key type="TextField"><Required>Y</Required><mask>/^[A-Za-z0-9+\/]{43}=$/</mask></public_key>
      <preshared_key type="TextField"><Required>N</Required><mask>/^([A-Za-z0-9+\/]{43}=)?$/</mask></preshared_key>
      <allowed_ips type="TextField"><Required>Y</Required><mask>/^([0-9a-fA-F:\.]+\/\d{1,3})(,\s*[0-9a-fA-F:\.]+\/\d{1,3})*$/</mask></allowed_ips>
      <persistent_keepalive type="IntegerField"><Required>N</Required><MinimumValue>0</MinimumValue><MaximumValue>65535</MaximumValue></persistent_keepalive>
      <description type="TextField"><Required>N</Required></description>
    </peer>
  </items>
</model>
