<form>
 <field><id>server.enabled</id><label>Enabled</label><type>checkbox</type><grid_view><type>boolean</type><formatter>rowtoggle</formatter></grid_view></field>
 <field><id>server.runtime</id><label>Status</label><type>ignore</type><grid_view><formatter>serverstatus</formatter><sortable>false</sortable><width>100</width></grid_view></field>
 <field><id>server.name</id><label>Name</label><type>text</type><help>Unique server name, max 15 chars</help></field>
 <field><id>server.interface_number</id><label>Interface Number</label><type>text</type><help>Creates awgN. Number must be free across clients and servers.</help></field>
 <field><id>server.listen_port</id><label>Listen Port</label><type>text</type><help>UDP port accepted by this server</help></field>
 <field><id>server.clients_endpoint</id><label>Clients Endpoint</label><type>text</type><help>Provisioning-only public endpoint used when generating client QR codes and .conf files, e.g. vpn.example.com:4433. It is never written to the server runtime config.</help><grid_view><ignore>true</ignore></grid_view></field>
 <field><id>server.clients_keepalive</id><label>Clients Keepalive</label><type>text</type><help>Provisioning-only PersistentKeepalive value written to generated client configurations. Default: 25 seconds. It is never written to the server runtime config.</help><grid_view><ignore>true</ignore></grid_view></field>
 <field><id>server.clients_dns</id><label>Clients DNS</label><type>text</type><help>Optional DNS server addresses written to generated client configurations. Multiple addresses may be separated by commas.</help><grid_view><ignore>true</ignore></grid_view></field>
 <field><id>server.address</id><label>Tunnel Address</label><type>text</type><help>Server-side tunnel address, e.g. 10.8.1.1/24</help></field>
 <field><id>server.description</id><label>Description</label><type>text</type></field>
 <field><id>server.private_key</id><label>Private Key</label><type>text</type><help>Stored outside config.xml. Use Generate Keypair for a new server.</help><grid_view><ignore>true</ignore></grid_view></field>
 <field><id>server.mtu</id><label>MTU</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field>
 <field><type>header</type><label>AmneziaWG Obfuscation Parameters</label></field>
 <field><id>server.jc</id><label>Jc</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.jmin</id><label>Jmin</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.jmax</id><label>Jmax</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field>
 <field><id>server.s1</id><label>S1</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.s2</id><label>S2</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.s3</id><label>S3</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.s4</id><label>S4</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field>
 <field><id>server.h1</id><label>H1</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.h2</id><label>H2</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.h3</id><label>H3</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.h4</id><label>H4</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field>
 <field><type>header</type><label>CPS (Custom Protocol Signature)</label></field>
 <field><id>server.i1</id><label>I1</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.i2</id><label>I2</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.i3</id><label>I3</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.i4</id><label>I4</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field><field><id>server.i5</id><label>I5</label><type>text</type><grid_view><ignore>true</ignore></grid_view></field>
</form>
